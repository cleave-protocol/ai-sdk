{
  "name": "@cleave-protocol/ai-sdk",
  "version": "0.1.2",
  "description": "Cleave agent tools for the Vercel AI SDK: plan swaps as unsigned calls, track them, find tokens, and order gas top-ups, submitting the gas orders a wallet has signed.",
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "tools",
    "agents",
    "dex",
    "dex-aggregator",
    "swap",
    "cross-chain",
    "bridge",
    "ethereum",
    "arbitrum",
    "base",
    "bnb",
    "polygon",
    "optimism"
  ],
  "homepage": "https://cleave.fi/docs/agents",
  "bugs": {
    "url": "https://github.com/cleave-protocol/ai-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cleave-protocol/ai-sdk.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc",
    "test": "vitest run",
    "lint": "publint && attw --pack .",
    "probe": "npm run build && node scripts/probe.mjs",
    "rename": "node scripts/rename.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run lint"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0"
  },
  "peerDependencies": {
    "ai": "^6.0.0 || ^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.5",
    "ai": "^7.0.159",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
